FROM oven/bun:1.3.14-alpine@sha256:5acc90a93e91ff07bf72aa90a7c9f0fa189765aec90b47bdbf2152d2196383c0 AS web
WORKDIR /build
COPY package.json bun.lock tsconfig.json vite.browser.config.ts ./
RUN bun install --frozen-lockfile --ignore-scripts
COPY src/ src/
COPY browser/ browser/
RUN bun run build:browser

FROM rust:1.94-bookworm@sha256:6ae102bdbf528294bc79ad6e1fae682f6f7c2a6e6621506ba959f9685b308a55 AS rust-build
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY vendor/zip/ vendor/zip/
COPY src-tauri/Cargo.toml src-tauri/build.rs src-tauri/
COPY src-tauri/src/ src-tauri/src/
RUN --mount=type=cache,id=gogglelab-public-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=gogglelab-public-server-target,target=/build/target \
    cargo build --release --locked -p library-server --bin gogglelab-server \
    && mkdir -p /build/server-bin \
    && cp /build/target/release/gogglelab-server /build/server-bin/gogglelab-server
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
COPY package.json LICENSE ./
COPY scripts/prepare-licenses.py scripts/prepare-licenses.py
COPY resources/licenses/ resources/licenses/
COPY --from=web /build/node_modules/ node_modules/
RUN --mount=type=cache,id=gogglelab-public-registry,target=/usr/local/cargo/registry \
    python3 scripts/prepare-licenses.py --project /build

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 gogglelab \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /data gogglelab \
    && mkdir -p /data /app/web /run/secrets \
    && chown 10001:10001 /data
COPY --from=rust-build /build/server-bin/gogglelab-server /usr/local/bin/gogglelab-server
COPY --from=web /build/dist-browser/ /app/web/
COPY --from=rust-build /build/LICENSE /app/LICENSE
COPY --from=rust-build /build/resources/licenses/ /app/licenses/
COPY deploy/server-container.json /app/server-config.json
USER 10001:10001
WORKDIR /data
EXPOSE 3745
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:3745/api/v1/health >/dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/gogglelab-server"]
CMD ["--library", "/data/library", "--config", "/app/server-config.json", "--web", "/app/web", "--listen", "0.0.0.0:3745", "--token-file", "/run/secrets/gogglelab-token"]
